# Third-party checkouts, model weights and installers
dependencies/
archive/

# Authoritative source footage, kept outside git
footage/
*.mp4

# Downloaded CC0 panoramas (refetch from the provenance json)
assets/hdri/*.exr
assets/hdri/*.hdr

# Rendered environments and probe bakes
scene_library/**/*.exr
scene_library/**/probes/
scene_library/**/background/
scene_library/**/*.blend1

# Per-shot derived caches, all reproducible from scripts
music_videos/**/source/frames/
music_videos/**/key/
music_videos/**/relight/depth/
music_videos/**/relight/controls/
music_videos/**/relight/normals/
music_videos/**/relight/proxy/
music_videos/**/relight/proxy_r4*/
music_videos/**/relight/proxy_render/
music_videos/**/intermediate/
music_videos/**/composite/
music_videos/**/final/
music_videos/**/master/
music_videos/**/relight/albedo/
music_videos/**/relight/skin_mask/
music_videos/**/relight/iris_observations/

# Raw tool spew; structured JSON evidence is kept
**/logs/*.log
**/logs/*.txt
logs/sh_convention/*.exr
__pycache__/
*.pyc

# Agent tool state, including worktrees a session may create
.claude/
