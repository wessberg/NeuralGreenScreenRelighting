    "layer": "C:\\Users\\Frede\\Developer\\blender-virtual-production-experiment\\music_videos\\reporter_test\\shots\\reporter_a\\key\\specular",
    "present": true,
    "why": "a smooth R can recolour a highlight but cannot move or delete one, so with the plate specular left in, every shot keeps reporting where the ORIGINAL room's lamps were -- the crown sheen, the lip gloss, and the corneal catchlight most of all"
  },
  "source_band_limit": {
    "sigma_px": 0.0,
    "source": "disabled -- round 4 behaviour",
    "bandwidth_table": [],
    "rule": "you may only divide out lighting at the resolution at which you can put it back. Below the crossover E_target cannot restore what E_source removes, so R carries 1/E_source and brightens whatever the original key had shaded"
  },
