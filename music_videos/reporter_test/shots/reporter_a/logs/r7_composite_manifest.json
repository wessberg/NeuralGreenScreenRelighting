  "specular": {
    "gain": 1.0,
    "mean_fraction_of_image": null,
    "model": "GGX + Schlick Fresnel on the NEURAL normals, added not multiplied",
    "light_direction": "estimated per frame from the L1 moment of the rendered irradiance field, so it also works for environments",
    "magnitude": "normalised GGX lobe (peak 1) x the rendered irradiance, so it carries the real light level, colour AND occlusion",
